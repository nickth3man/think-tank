# Think Tank — environment variables
#
# The app reads configuration from the process environment; it does not load a
# .env file. Export what you need in your shell (e.g. append to ~/.zshenv) and
# open a new shell:
#
#   cat .env.example >> ~/.zshenv
#
# Provider policy:
#   ollama_cloud (default chat)  deepseek-v4.1-flash
#   mistral                      mistral-small-latest (or a larger Mistral)
#   opencode                     deepseek-v4.1-flash
#   zai                          glm-5.3
#   openrouter                   EMBEDDINGS ONLY — never used for agent chat.
#
# Credential lines are commented out on purpose: exporting an empty value would
# shadow a real key already present in your shell.

# ── Provider selection ──────────────────────────────────────────────────────
# Chat provider: ollama_cloud | mistral | opencode | zai
export THINK_TANK_PROVIDER=ollama_cloud

# Embeddings provider: openrouter (default) | mistral
export THINK_TANK_EMBEDDING_PROVIDER=openrouter

# Optional model overrides
# export THINK_TANK_CHAT_MODEL=deepseek-v4.1-flash
# export THINK_TANK_EMBEDDING_MODEL=openai/text-embedding-3-small

# Per-agent overrides (agents: researcher | skeptic | visionary | synthesizer)
# export THINK_TANK_RESEARCHER_PROVIDER=mistral
# export THINK_TANK_RESEARCHER_MODEL=mistral-small-latest
# export THINK_TANK_VISIONARY_PROVIDER=zai
# export THINK_TANK_VISIONARY_MODEL=glm-5.3

# ── Provider credentials ────────────────────────────────────────────────────
# export OLLAMA_CLOUD_API_KEY=...        # chat (default)
# export MISTRAL_API_KEY=...             # chat + optionally embeddings
# export OPENCODE_API_KEY=...            # chat
# export ZAI_API_KEY=...                 # chat
# export OPENROUTER_API_KEY=sk-or-...    # embeddings

# ── OpenRouter attribution (optional) ──────────────────────────────────────
# export OPENROUTER_APP_URL=https://github.com/your-org/think-tank
# export OPENROUTER_APP_TITLE="Think Tank"

# ── Base URL overrides (tests) ──────────────────────────────────────────────
# Redirect one provider at a local stub server. The integration tests set these
# themselves; they are listed so a manual stub run is reproducible.
# export THINK_TANK_BASE_URL_OLLAMA_CLOUD=http://127.0.0.1:8080/v1
# export THINK_TANK_BASE_URL_OPENROUTER=http://127.0.0.1:8080/v1

# ── Storage ────────────────────────────────────────────────────────────────
# Knowledge-base directory (defaults to ./kb_store). One JSON collection is
# written per embedding space.
# export THINK_TANK_KB_PATH=./kb_store

# ── Performance ────────────────────────────────────────────────────────────
# Completion cap. A runaway guard, not a length control: a tighter value does
# not shorten output on these prompts and can truncate a tool call.
# export THINK_TANK_MAX_TOKENS=4096

# Reasoning effort. Only sent to providers that accept it (ollama_cloud);
# Mistral answers HTTP 400 for models without reasoning support.
# export THINK_TANK_REASONING_EFFORT=none

# Print a per-stage latency profile at exit.
# export THINK_TANK_PROFILE=1
